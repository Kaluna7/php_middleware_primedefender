# Required for incident reporting (bridge appends /ingest if URL has no path)
PRIMEDEFENDER_BRIDGE_URL=http://localhost:3000
PRIMEDEFENDER_API_KEY=your_api_key
PRIMEDEFENDER_SITE_ID=my-service

# Target site coordinates (map "to" pin)
PRIMEDEFENDER_SITE_LAT=-8.6705
PRIMEDEFENDER_SITE_LON=115.2126

# Human-readable target label: targetLabel = "{SITE_ID} · {SITE_REGION_LABEL}"
PRIMEDEFENDER_SITE_REGION_LABEL=Indonesia, Bali

# Optional: label for private/loopback IPs when not using X-Prime-* test headers
PRIMEDEFENDER_PRIVATE_SOURCE_LABEL=Local / private network

# observe = log/report only; block = same as other threats (403)
PRIMEDEFENDER_AUTH_BYPASS_MODE=observe
PRIMEDEFENDER_SUSPICIOUS_REQUEST_MODE=observe

# Global per-IP rate limit (sliding window); over limit → detection ddos, HTTP 429
PRIMEDEFENDER_FLOOD_WINDOW_SECONDS=10
PRIMEDEFENDER_FLOOD_MAX_REQUESTS=60
# Comma-separated paths not counted toward flood (unset = default /health only; empty = no exemptions)
# PRIMEDEFENDER_FLOOD_EXEMPT_PATHS=/health,/ready

# Optional tuning
PRIMEDEFENDER_BODY_CAP_BYTES=16384
PRIMEDEFENDER_GEOIP_TTL_SECONDS=3600
PRIMEDEFENDER_GEOIP_TIMEOUT_SECONDS=2.5
PRIMEDEFENDER_BRIDGE_TIMEOUT_SECONDS=3.0
# Block query/body with more than N successive percent-decoding layers (0 = off). Default 3.
PRIMEDEFENDER_MAX_ENCODING_LAYERS=3
PRIMEDEFENDER_DEBUG=false
